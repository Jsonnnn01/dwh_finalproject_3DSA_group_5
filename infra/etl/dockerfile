FROM python:3.11-slim

# Install dependencies required for psycopg2 and common tools
# Added postgresql-client to allow running psql commands
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    wget \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# copy requirements and install
COPY infra/etl/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# copy scripts
COPY scripts /app/scripts
RUN chmod -R a+rX /app/scripts

ENV PYTHONUNBUFFERED=1

# Keep container running for exec usage, or allow override
ENTRYPOINT ["tail", "-f", "/dev/null"]
